server {
	listen 80 default_server;
	listen [::]:80 default_server;

	root %%INSTALLATION_PATH%%/src/webapp/build;

	index index.html index.htm;

	server_name _;

	# nginx.conf only compresses text/html by default; the JS bundle is ~0.9MB raw
	gzip_types text/css application/javascript application/json image/svg+xml;
	gzip_vary on;
	gzip_comp_level 5;

	location /static/ {
		# Build output under /static carries a content hash in its filename
		add_header Cache-Control "public, max-age=31536000, immutable";
		try_files $uri =404;
	}

	location / {
 		location = /index.html {
 			 # Never cache the entry document, so a rebuilt WebApp (new hashed
 			 # bundle filenames) is picked up immediately instead of the browser
 			 # keeping a stale index.html that points at an old bundle.
 			 add_header Cache-Control "no-store" always;
 			 error_page 404 = @buildwebui;
 			 log_not_found off;
 		}
 		location = / {
 			 add_header Cache-Control "no-store" always;
		         error_page 404 = @buildwebui;
			 log_not_found off;
 		}
		try_files $uri $uri/ =404;
	}

	location /logs {
			root %%INSTALLATION_PATH%%/shared;

			autoindex on;
			autoindex_exact_size off;
			autoindex_localtime on;

			default_type text/plain;
	}

	location @buildwebui {
 		 root %%INSTALLATION_PATH%%/resources/html;
		 try_files /runbuildui.html =404;
 		 internal;
 	}

    error_page 404 = /404.html;
    location /404.html {
        root %%INSTALLATION_PATH%%/resources/html;
        internal;
    }
}
